{
  "name": "@pdomain/pdomain-ui",
  "version": "0.11.0",
  "type": "module",
  "description": "Shared TS/React/Vite frontend library for the pdomain-* suite",
  "author": "CT <concavetrillion@gmail.com>",
  "license": "Unlicense",
  "repository": {
    "type": "git",
    "url": "https://github.com/pdomain/pdomain-ui.git"
  },
  "homepage": "https://github.com/pdomain/pdomain-ui",
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "registry": "https://pdomain.github.io/pdomain-index-npm/"
  },
  "files": [
    "dist",
    "theme",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./canvas": {
      "import": "./dist/canvas.js",
      "types": "./dist/canvas.d.ts"
    },
    "./worklist": {
      "import": "./dist/worklist.js",
      "types": "./dist/worklist.d.ts"
    },
    "./shell": {
      "import": "./dist/shell.js",
      "types": "./dist/shell.d.ts"
    },
    "./primitives": {
      "import": "./dist/primitives.js",
      "types": "./dist/primitives.d.ts"
    },
    "./icons": {
      "import": "./dist/icons.js",
      "types": "./dist/icons.d.ts"
    },
    "./types": {
      "import": "./dist/types.js",
      "types": "./dist/types.d.ts"
    },
    "./stores": {
      "import": "./dist/stores.js",
      "types": "./dist/stores.d.ts"
    },
    "./testids": {
      "import": "./dist/testids.js",
      "types": "./dist/testids.d.ts"
    },
    "./templates": {
      "import": "./dist/templates.js",
      "types": "./dist/templates.d.ts"
    },
    "./stages/PageWorkbench": {
      "import": "./dist/stages/PageWorkbench/index.js",
      "types": "./dist/stages/PageWorkbench/index.d.ts"
    },
    "./stages/Source": {
      "import": "./dist/stages/Source/index.js",
      "types": "./dist/stages/Source/index.d.ts"
    },
    "./stages/Grayscale": {
      "import": "./dist/stages/Grayscale/index.js",
      "types": "./dist/stages/Grayscale/index.d.ts"
    },
    "./stages/Crop": {
      "import": "./dist/stages/Crop/index.js",
      "types": "./dist/stages/Crop/index.d.ts"
    },
    "./stages/HyphenJoin": {
      "import": "./dist/stages/HyphenJoin/index.js",
      "types": "./dist/stages/HyphenJoin/index.d.ts"
    },
    "./stages/Validation": {
      "import": "./dist/stages/Validation/index.js",
      "types": "./dist/stages/Validation/index.d.ts"
    },
    "./stages/QualityFlags": {
      "import": "./dist/stages/QualityFlags/index.js",
      "types": "./dist/stages/QualityFlags/index.d.ts"
    },
    "./stages/Scannos": {
      "import": "./dist/stages/Scannos/index.js",
      "types": "./dist/stages/Scannos/index.d.ts"
    },
    "./stages/PageReorder": {
      "import": "./dist/stages/PageReorder/index.js",
      "types": "./dist/stages/PageReorder/index.d.ts"
    },
    "./stages/Upload": {
      "import": "./dist/stages/Upload/index.js",
      "types": "./dist/stages/Upload/index.d.ts"
    },
    "./theme/tokens.css": "./theme/tokens.css",
    "./theme/reset.css": "./theme/reset.css",
    "./theme/primitives.css": "./theme/primitives.css",
    "./hooks": {
      "import": "./dist/hooks.js",
      "types": "./dist/hooks.d.ts"
    },
    "./records": {
      "import": "./dist/records.js",
      "types": "./dist/records.d.ts"
    },
    "./source-intake": {
      "import": "./dist/source-intake.js",
      "types": "./dist/source-intake.d.ts"
    },
    "./viewport": {
      "import": "./dist/viewport.js",
      "types": "./dist/viewport.d.ts"
    },
    "./settings": {
      "import": "./dist/settings.js",
      "types": "./dist/settings.d.ts"
    },
    "./status": {
      "import": "./dist/status.js",
      "types": "./dist/status.d.ts"
    },
    "./workbench": {
      "import": "./dist/workbench.js",
      "types": "./dist/workbench.d.ts"
    }
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0",
    "react-konva": "^19.0.0"
  },
  "peerDependenciesMeta": {
    "react-konva": {
      "optional": false
    }
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@radix-ui/react-accordion": "^1.2.20",
    "@radix-ui/react-alert-dialog": "^1.1.23",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-switch": "^1.3.7",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-toggle-group": "^1.1.19",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@tanstack/react-virtual": "^3.14.9",
    "clsx": "^2.1.1",
    "konva": "^10.3.1",
    "lucide-react": "^1.31.0",
    "react-virtuoso": "^4.18.11",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@storybook/addon-a11y": "^10.5.8",
    "@storybook/react": "^10.5.8",
    "@storybook/react-vite": "^10.5.8",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.4",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@typescript-eslint/eslint-plugin": "^8.67.0",
    "@typescript-eslint/parser": "^8.67.0",
    "@vitejs/plugin-react": "^6.0.5",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^10.8.1",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^30.0.1",
    "knip": "^6.32.2",
    "openapi-typescript": "^7.13.0",
    "prettier": "^3.9.6",
    "react-konva": "^19.2.5",
    "sirv-cli": "^3.0.1",
    "storybook": "^10.5.8",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.2.1",
    "vite-plugin-dts": "^5.0.3",
    "vitest": "^4.1.10"
  },
  "scripts": {
    "lint": "eslint src tests",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run --exclude tests/build.contract.test.ts --exclude tests/build.smoke.test.ts --exclude tests/pack.contract.test.ts --exclude tests/pack/testids.contract.test.ts",
    "test:package": "vitest run tests/build.smoke.test.ts && vitest run tests/build.contract.test.ts tests/pack.contract.test.ts tests/pack/testids.contract.test.ts",
    "build": "vite build",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"tests/**/*.{ts,tsx}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\" \"tests/**/*.{ts,tsx}\"",
    "knip": "knip",
    "codegen": "node scripts/codegen-fetch.mjs && node scripts/codegen-emit.mjs && node scripts/codegen-tsgen.mjs",
    "codegen:check": "node scripts/codegen-fetch.mjs && node scripts/codegen-emit.mjs && node scripts/codegen-tsgen.mjs && git diff --exit-code src/types/generated/",
    "sync:design-system": "node scripts/sync-design-system.mjs",
    "codegen:theme-check": "node scripts/sync-design-system.mjs --check",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build -o storybook-static"
  }
}
